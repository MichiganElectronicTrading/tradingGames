/* MET Games — shared classic-TUI styles.
   bg #0B0F14 · text #C9D1D9 · dim #8B97A5 · border #3FA7B5 · titles #5FD4E0
   highlight #F2C14E · green #5BD17A · red #FF6B6B */

Screen {
    background: #0B0F14;
    color: #C9D1D9;
}

ModalScreen {
    background: #0B0F14 70%;
    align: center middle;
}

/* the pause menu is opaque: the board behind it stays hidden */
PauseMenu {
    background: #0B0F14;
}

TopBar {
    dock: top;
    height: 1;
    background: #5FD4E0;
    color: #000000;
    text-style: bold;
}

KeyBar {
    dock: bottom;
    height: 1;
    background: #C9D1D9;
    color: #0B0F14;
}

TitledPanel {
    height: auto;
    border: solid #3FA7B5;
    border-title-color: #5FD4E0;
    border-title-style: bold;
    border-subtitle-color: #8B97A5;
    padding: 0 1;
}

TitledPanel.double {
    border: double #3FA7B5;
}

.dim {
    color: #8B97A5;
}

.hidden {
    display: none;
}

RowList {
    height: auto;
    width: 1fr;
}

KeyButton {
    width: auto;
    height: 1;
    padding: 0 1;
    margin-right: 2;
    text-style: bold;
    color: #000000;
    background: #3FA7B5;
}

KeyButton:hover {
    text-style: bold reverse;
}

KeyButton:disabled {
    background: #1C232C;
    color: #8B97A5;
    text-style: strike;
}

KeyButton.buy {
    background: #5BD17A;
}

KeyButton.sell {
    background: #FF6B6B;
}

KeyButton:disabled.buy, KeyButton:disabled.sell {
    background: #1C232C;
}

KeyButton.start {
    width: 100%;
    height: 3;
    margin: 1 0 0 0;
    content-align: center middle;
    background: #5BD17A;
}

CardWidget {
    width: 8;
    height: 5;
    border: solid #8B97A5;
    margin-right: 1;
}

CardWidget.fresh {
    border: heavy #F2C14E;
}

.event-banner {
    width: 100%;
    height: 1;
    background: #F2C14E;
    color: #000000;
    text-style: bold;
    padding: 0 1;
}

Input {
    height: 1;
    width: 20;
    border: none;
    padding: 0 1;
    background: #1C232C;
    color: #F2C14E;
    text-style: bold;
}

Input:focus {
    border: none;
    background: #2A3340;
}

Input:disabled {
    background: #0B0F14;
}

Input.wide {
    width: 100%;
}

VerticalScroll {
    scrollbar-color: #3FA7B5;
    scrollbar-background: #0B0F14;
}
